#!/bin/bash
# autogenerated script
export JAVA_HOME=$(dirname $(dirname $(readlink -f $(which java))))
export PATH=$JAVA_HOME/bin:{{ jar_file_full_path | dirname }}:/usr/local/bin:$PATH
{% for env_option in additional_environment %}
export {{ env_option }}
{% endfor %}

# executing the bambooagent
exec $JAVA_HOME/bin/java \
    {{ java_additional_options | join(" ") }} \
    -jar {{ jar_file_full_path }} \
    {{ bamboo_server_url }}/agentServer/ \
    {{ security_token | ternary('-t ' + security_token,'') }}
